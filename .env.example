ANTHROPIC_API_KEY=sk-ant-api03-INSERISCI-LA-TUA-CHIAVE-QUI
DATABASE_URL="file:./dev.db"

# NextAuth v5 (Auth.js)
# AUTH_SECRET: genera con `openssl rand -base64 32`
AUTH_SECRET="genera-una-stringa-random"
AUTH_URL=http://localhost:3000
# Retro-compatibilità (NextAuth v5 legge anche queste se AUTH_* mancano)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-una-stringa-random"

# OAuth providers (credenziali di produzione)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
AUTH_MICROSOFT_TENANT=common      # 'common' = multi-tenant (account personali + work)

# Plan limits (placeholder finché il pricing non è definito)
PLAN_PRO_USERS_PER_ORG=3
PLAN_PRO_ORGS_PER_USER=1
PLAN_ADVANCED_USERS_PER_ORG=10
PLAN_ADVANCED_ORGS_PER_USER=3
PLAN_ENTERPRISE_USERS_PER_ORG=999
PLAN_ENTERPRISE_ORGS_PER_USER=999

# Cron (trial expiry checker) — proteggi l'endpoint /api/cron/trial-check
CRON_SECRET="genera-una-stringa-random"

# Email transazionale (Resend) — necessario per email di sistema
# Registrati su https://resend.com per ottenere la chiave API
# Il dominio in RESEND_FROM deve essere verificato nel pannello Resend
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM="Anlyra <noreply@anlyra.it>"

# URL pubblico del sito (usato da robots.ts, sitemap.ts, OG metadata)
# In produzione settare a https://anlyra.it
NEXT_PUBLIC_SITE_URL=http://localhost:3000
