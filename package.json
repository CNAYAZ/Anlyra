{
  "name": "anlyra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-http-header-size=65536' next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:check-rls": "tsx prisma/check-rls.ts",
    "db:push": "tsx prisma/guard.ts \"npm run db:push\" && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "tsx prisma/guard.ts \"npm run prisma:push\" && prisma db push",
    "prisma:migrate": "tsx prisma/guard.ts \"npm run prisma:migrate\" && prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
